# LLM Provider: deepseek 或 openai
LLM_PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 配置（备选）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# 生成参数
TEMPERATURE=0.3
MAX_TOKENS=4096
